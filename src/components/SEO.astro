---
import type { SiteData } from '../lib/content';

export interface Props {
  siteData: SiteData;
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  googleSiteVerification?: string;
  bingSiteVerification?: string;
}

const {
  siteData,
  title: propTitle,
  description: propDescription,
  image: propImage,
  canonicalUrl: propCanonical,
  googleSiteVerification: propGoogleVerification,
  bingSiteVerification: propBingVerification
} = Astro.props;

const googleVerification = propGoogleVerification || import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = propBingVerification || import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const baseUrl = (Astro.site ? Astro.site.toString() : 'https://vishalrashmika.com').replace(/\/$/, '');
const title = propTitle || `${siteData.profile.name} — Software Engineer & Systems Developer`;
const description =
  propDescription ||
  'Vishal Rashmika is a Software Engineer based in Sri Lanka specializing in systems programming, cybersecurity, and web development.';
const canonicalUrl = propCanonical || new URL(Astro.url.pathname, baseUrl).href;
const socialImage = propImage ? (propImage.startsWith('http') ? propImage : `${baseUrl}${propImage}`) : `${baseUrl}/homepage-logo.png`;
const avatarImage = `${baseUrl}/me.png`;
const keywords = [
  'Vishal Rashmika',
  'Vishal Rashmika Developer',
  'Vishal Rashmika Software Engineer',
  'Vishal Rashmika Sri Lanka',
  'Vishal Rashmika Portfolio',
  'Vishal Rashmika GitHub',
  'Vishal Rashmika LinkedIn',
  'Vishal Rashmika OlyraLabs',
  'KernelMe',
  'J.M. Vishal Rashmika Perera',
  'Vishal Rashmika Perera',
  'Systems Developer Sri Lanka',
  'Software Engineer Sri Lanka',
  'Cybersecurity Researcher',
  'Reverse Engineering x86-64',
  'Infosec Researcher',
  'KernelMeOS',
  'OlyraLabs',
  'Office Suite Obsidian',
  'Canvas++ Obsidian',
  'agyq Antigravity',
  'LangDetect.Net',
  'WyrdLang',
  'Sinso API',
  'Blossom Theme',
  'NASA Space Apps Challenge 2026',
  'DevDash 2026 Hackathon',
  'The Radio Society of Sri Lanka',
  'Smithsonian Digital Volunteer',
  'AWS Educate Generative AI',
  'AI Skills Fest 2026',
  'Dean\'s List Software Engineering',
  'University of Central Lancashire UCL',
  'Assembly x86-64',
  'C++',
  'Rust',
  'Go Systems Programming',
  'Python',
  'TypeScript',
  'React 19',
  'Astro SSG',
  'Tailwind CSS',
  '.NET Core',
  'Linux Internals',
  'Penetration Testing',
  'Oracle Cloud Infrastructure'
].join(', ');

// Comprehensive Schema.org graph for Google Knowledge Graph, Site Names, and AI/LLM indexing
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      'url': `${baseUrl}/`,
      'name': 'Vishal Rashmika',
      'alternateName': ['vishalrashmika.com', 'Vishal Rashmika Portfolio', 'Vishal Rashmika Official'],
      'headline': `${siteData.profile.name} — Software Engineer & Systems Developer`,
      'description': description,
      'publisher': {
        '@id': `${baseUrl}/#person`
      },
      'author': {
        '@id': `${baseUrl}/#person`
      },
      'inLanguage': 'en-US'
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${baseUrl}/#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${baseUrl}/`
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': siteData.profile.name,
          'item': `${baseUrl}/`
        }
      ]
    },
    {
      '@type': 'ProfilePage',
      '@id': `${baseUrl}/#profilepage`,
      'url': canonicalUrl,
      'name': title,
      'isPartOf': {
        '@id': `${baseUrl}/#website`
      },
      'breadcrumb': {
        '@id': `${baseUrl}/#breadcrumb`
      },
      'about': {
        '@id': `${baseUrl}/#person`
      },
      'mainEntity': {
        '@id': `${baseUrl}/#person`
      },
      'description': description,
      'inLanguage': 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${baseUrl}/#person`,
      'name': siteData.profile.name,
      'givenName': 'Vishal',
      'familyName': 'Rashmika',
      'additionalName': 'Perera',
      'alternateName': [
        'J.M. Vishal Rashmika Perera',
        'Vishal Rashmika Perera',
        'KernelMe',
        'vishalrashmika',
        'Vishal'
      ],
      'jobTitle': 'Software Engineer & Systems Developer',
      'hasOccupation': {
        '@type': 'Occupation',
        'name': 'Software Engineer & Systems Developer',
        'occupationalCategory': '15-1252.00',
        'skills': 'Systems Programming, Reverse Engineering, Cybersecurity, Full-Stack Web Development, C++, Rust, Python, TypeScript, React, Astro'
      },
      'url': baseUrl,
      'mainEntityOfPage': baseUrl,
      'image': {
        '@type': 'ImageObject',
        'url': avatarImage,
        'caption': siteData.profile.name
      },
      'email': 'mailto:vishal@vishalrashmika.com',
      'description': description,
      'worksFor': {
        '@type': 'Organization',
        'name': 'OlyraLabs',
        'jobTitle': 'Co-Founder & Tech Lead'
      },
      'sameAs': [
        'https://github.com/VishalRashmika',
        'https://www.linkedin.com/in/vishalrashmika/',
        'https://x.com/Vishal_Rashmika',
        'https://twitter.com/Vishal_Rashmika',
        'https://www.youtube.com/@VishalRashmika',
        'https://blog.vishalrashmika.com',
        'https://medium.com/@VishalRashmika',
        'https://behance.net/vishalrashmika',
        'https://www.instagram.com/j.m.v.r.p/',
        'https://www.buymeacoffee.com/vishalrashmika/'
      ],
      'address': {
        '@type': 'PostalAddress',
        'addressCountry': 'LK'
      },
      'nationality': {
        '@type': 'Country',
        'name': 'Sri Lanka'
      },
      'knowsLanguage': ['en', 'si'],
      'alumniOf': siteData.education.map((edu) => ({
        '@type': 'EducationalOrganization',
        'name': edu.institution,
        ...(edu.institutionUrl ? { 'url': edu.institutionUrl } : {})
      })),
      'hasCredential': siteData.certifications.map((cert) => ({
        '@type': 'EducationalOccupationalCredential',
        'name': cert.name,
        'credentialCategory': 'Professional Certification',
        'recognizedBy': {
          '@type': 'Organization',
          'name': cert.issuer
        },
        'url': cert.url,
        'validIn': {
          '@type': 'AdministrativeArea',
          'name': 'Worldwide'
        }
      })),
      'award': [
        "Dean's List 2026–2027",
        "10% Academic Excellence Scholarship",
        "UCL International Foundation Year Merit Scholarship",
        "NASA International Space Apps Challenge 2026 Participant",
        "DevDash'26 Inaugural Hackathon Certificate of Participation"
      ],
      'memberOf': [
        {
          '@type': 'Organization',
          'name': 'The Radio Society of Sri Lanka',
          'url': 'https://rssl.lk'
        },
        {
          '@type': 'Organization',
          'name': 'Smithsonian Institution',
          'url': 'https://transcription.si.edu'
        }
      ],
      'knowsAbout': [
        'Software Engineering',
        'Systems Programming',
        'Cybersecurity',
        'Reverse Engineering',
        'x86-64 Assembly Disassembly',
        'C',
        'C++',
        'Rust',
        'Go',
        'Python',
        'TypeScript',
        'JavaScript',
        'C#',
        '.NET Framework',
        'Obsidian Plugin Development',
        'CLI Architecture',
        'Linux System Administration & Internals',
        'Penetration Testing & Forensics',
        'Web Application Security',
        'Astro Framework',
        'React',
        'Tailwind CSS',
        'Oracle Cloud Infrastructure (OCI)',
        'NASA Space Apps Challenge',
        'Generative AI & LLMs',
        'Amateur Radio & RF Technologies',
        'Morse Code (CW)',
        'Visual Diagramming & JSON Canvas'
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#projects`,
      'name': 'Featured Software Engineering Projects',
      'description': 'Selected software systems and tools developed by Vishal Rashmika',
      'itemListElement': siteData.projects.map((proj, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': proj.name,
          'description': proj.description,
          'url': proj.demo || proj.github || baseUrl,
          ...(proj.github ? { 'codeRepository': proj.github } : {}),
          ...(proj.tags && proj.tags.length > 0 ? { 'keywords': proj.tags.join(', ') } : {})
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#blog`,
      'name': 'Technical Articles & Publications',
      'description': 'Engineering notes, reverse engineering tutorials, and systems writeups by Vishal Rashmika',
      'itemListElement': siteData.blogPosts.map((post, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': post.title,
          'url': post.href,
          'author': {
            '@id': `${baseUrl}/#person`
          },
          ...(post.excerpt ? { 'description': post.excerpt } : {})
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#achievements`,
      'name': 'Academic Honors & Excellence Scholarships',
      'description': 'Academic honors, dean\'s list rankings, and merit scholarships awarded to Vishal Rashmika',
      'itemListElement': (((siteData as any).achievements || []) as any[]).map((ach, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': ach.title,
          'description': ach.description,
          'publisher': {
            '@type': 'Organization',
            'name': ach.issuer
          }
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#volunteering`,
      'name': 'Volunteering & Community Contributions',
      'description': 'Community involvement, amateur radio research, and public archive preservation by Vishal Rashmika',
      'itemListElement': (((siteData as any).volunteering || []) as any[]).map((vol, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': `${vol.role} — ${vol.organization}`,
          'description': vol.description,
          ...(vol.url ? { 'url': vol.url } : {})
        }
      }))
    }
  ]
};
---

<!-- Basic Meta & Title -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={siteData.profile.name} />
<meta name="creator" content={siteData.profile.name} />
<meta name="publisher" content={siteData.profile.name} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Search Engine Verification -->
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<!-- Canonical & Language Alternates -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- XML Sitemaps & Web App Manifest -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Favicon and App Icons -->
<link rel="icon" type="image/png" sizes="32x32" href="/icon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icon.png" />

<!-- LLM / AI Discovery Endpoints (llmstxt.org Standard) -->
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Context Summary" />
<link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Comprehensive LLM Technical Context" />
<link rel="alternate" type="text/markdown" href="/.well-known/llms.txt" title="Well-Known LLM Context" />
<meta name="ai-content-declaration" content={`${baseUrl}/llms.txt`} />
<meta name="llms" content={`${baseUrl}/llms.txt`} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="profile" />
<meta property="og:site_name" content="Vishal Rashmika" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Vishal Rashmika — Software Engineer & Systems Developer" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta property="profile:first_name" content="Vishal" />
<meta property="profile:last_name" content="Rashmika" />
<meta property="profile:username" content="VishalRashmika" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Vishal_Rashmika" />
<meta name="twitter:creator" content="@Vishal_Rashmika" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content="Vishal Rashmika — Software Engineer & Systems Developer" />

<!-- Mobile & Device Styling -->
<meta name="theme-color" content="#0a0a0c" />
<meta name="color-scheme" content="dark light" />
<meta name="application-name" content="Vishal Rashmika" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Vishal Rashmika" />
<meta name="format-detection" content="telephone=no" />

<!-- Structured Data (Schema.org JSON-LD Graph) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
