---
import type { SiteData } from '../lib/content';

export interface Props {
  siteData: SiteData;
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  googleSiteVerification?: string;
  bingSiteVerification?: string;
}

const {
  siteData,
  title: propTitle,
  description: propDescription,
  image: propImage,
  canonicalUrl: propCanonical,
  googleSiteVerification: propGoogleVerification,
  bingSiteVerification: propBingVerification
} = Astro.props;

const googleVerification = propGoogleVerification || import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = propBingVerification || import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const baseUrl = (Astro.site ? Astro.site.toString() : 'https://vishalrashmika.com').replace(/\/$/, '');
const title = propTitle || `${siteData.profile.name} (Vishal Rashmika Perera) — Software Engineer & Systems Developer`;
const description =
  propDescription ||
  'Official website of Vishal Rashmika (Vishal Rashmika Perera), a Sri Lanka-based Software Engineer and Systems Developer specializing in systems and web engineering.';
const canonicalUrl = propCanonical || new URL(Astro.url.pathname, baseUrl).href;
const socialImage = propImage ? (propImage.startsWith('http') ? propImage : `${baseUrl}${propImage}`) : `${baseUrl}/homepage-logo.png`;
const avatarImage = `${baseUrl}/me.png`;

const keywords = [
  'Vishal Rashmika',
  'Vishal Rashmika Perera',
  'Vishal Perera',
  'J.M. Vishal Rashmika Perera',
  'Vishal Rashmika Sri Lanka',
  'Vishal Perera Sri Lanka',
  'Vishal Rashmika Developer',
  'Vishal Rashmika Software Engineer',
  'Vishal Perera Software Engineer',
  'Vishal Rashmika Colombo',
  'Universal College Lanka UCL',
  'University of Central Lancashire',
  'Vishal Rashmika Portfolio',
  'Vishal Rashmika GitHub',
  'Vishal Rashmika LinkedIn',
  'Vishal Rashmika OlyraLabs',
  'KernelMe',
  'Systems Developer Sri Lanka',
  'Software Engineer Sri Lanka',
  'Reverse Engineering x86-64',
  'KernelMeOS',
  'OlyraLabs',
  'Office Suite Obsidian',
  'Canvas++ Obsidian',
  'agyq Antigravity',
  'LangDetect.Net',
  'WyrdLang',
  'Sinso API',
  'Blossom Theme',
  'NASA Space Apps Challenge 2026',
  'DevDash 2026 Hackathon',
  'The Radio Society of Sri Lanka',
  'Smithsonian Digital Volunteer',
  'AWS Educate Generative AI',
  'AI Skills Fest 2026',
  'Dean\'s List Software Engineering',
  'Assembly x86-64',
  'C++',
  'Rust',
  'Go Systems Programming',
  'Python',
  'TypeScript',
  'React 19',
  'Astro SSG',
  'Tailwind CSS',
  '.NET Core',
  'Linux Internals',
  'Oracle Cloud Infrastructure'
].join(', ');

// Comprehensive Schema.org graph for Google Knowledge Graph, Site Names, Geo-Entity, and AI/LLM indexing
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${baseUrl}/#website`,
      'url': `${baseUrl}/`,
      'name': 'Vishal Rashmika',
      'alternateName': [
        'Vishal Rashmika Perera',
        'Vishal Perera',
        'vishalrashmika.com',
        'Vishal Rashmika Portfolio',
        'Vishal Rashmika Official'
      ],
      'headline': `${siteData.profile.name} (Vishal Rashmika Perera) — Software Engineer & Systems Developer`,
      'description': description,
      'publisher': {
        '@id': `${baseUrl}/#person`
      },
      'author': {
        '@id': `${baseUrl}/#person`
      },
      'inLanguage': 'en-US'
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${baseUrl}/#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': `${baseUrl}/`
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': siteData.profile.name,
          'item': `${baseUrl}/`
        }
      ]
    },
    {
      '@type': 'ProfilePage',
      '@id': `${baseUrl}/#profilepage`,
      'url': canonicalUrl,
      'name': title,
      'isPartOf': {
        '@id': `${baseUrl}/#website`
      },
      'breadcrumb': {
        '@id': `${baseUrl}/#breadcrumb`
      },
      'about': {
        '@id': `${baseUrl}/#person`
      },
      'mainEntity': {
        '@id': `${baseUrl}/#person`
      },
      'description': description,
      'inLanguage': 'en-US'
    },
    {
      '@type': 'Person',
      '@id': `${baseUrl}/#person`,
      'name': siteData.profile.name,
      'legalName': 'J.M. Vishal Rashmika Perera',
      'givenName': 'Vishal',
      'additionalName': 'Rashmika',
      'familyName': 'Perera',
      'alternateName': [
        'Vishal Rashmika Perera',
        'Vishal Perera',
        'J.M. Vishal Rashmika Perera',
        'J. M. V. R. Perera',
        'Vishal Rashmika',
        'KernelMe'
      ],
      'jobTitle': 'Software Engineer & Systems Developer',
      'hasOccupation': {
        '@type': 'Occupation',
        'name': 'Software Engineer & Systems Developer',
        'occupationalCategory': '15-1252.00',
        'skills': 'Systems Programming, Reverse Engineering, Developer Tools, Full-Stack Web Development, C++, Rust, Go, Python, TypeScript, React, Astro'
      },
      'url': baseUrl,
      'mainEntityOfPage': baseUrl,
      'image': {
        '@type': 'ImageObject',
        'url': avatarImage,
        'caption': `${siteData.profile.name} (Vishal Rashmika Perera)`
      },
      'email': 'mailto:vishal@vishalrashmika.com',
      'description': description,
      'worksFor': {
        '@type': 'Organization',
        'name': 'OlyraLabs',
        'jobTitle': 'Co-Founder & Tech Lead'
      },
      'sameAs': [
        'https://github.com/VishalRashmika',
        'https://www.linkedin.com/in/vishalrashmika/',
        'https://x.com/Vishal_Rashmika',
        'https://twitter.com/Vishal_Rashmika',
        'https://www.youtube.com/@VishalRashmika',
        'https://blog.vishalrashmika.com',
        'https://medium.com/@VishalRashmika',
        'https://behance.net/vishalrashmika',
        'https://www.instagram.com/j.m.v.r.p/',
        'https://www.buymeacoffee.com/vishalrashmika/'
      ],
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': 'Colombo',
        'addressRegion': 'Western Province',
        'addressCountry': 'LK'
      },
      'homeLocation': {
        '@type': 'Place',
        'name': 'Colombo, Western Province, Sri Lanka',
        'geo': {
          '@type': 'GeoCoordinates',
          'latitude': 6.9271,
          'longitude': 79.8612
        }
      },
      'workLocation': {
        '@type': 'Place',
        'name': 'Colombo, Western Province, Sri Lanka'
      },
      'nationality': {
        '@type': 'Country',
        'name': 'Sri Lanka'
      },
      'knowsLanguage': ['en', 'si'],
      'alumniOf': [
        {
          '@type': 'EducationalOrganization',
          'name': 'University of Central Lancashire',
          'url': 'https://www.lancashire.ac.uk/'
        },
        {
          '@type': 'EducationalOrganization',
          'name': 'Universal College Lanka',
          'url': 'https://ucl.lk/'
        },
        ...siteData.education
          .filter((edu) => !edu.institution.includes('Lancashire') && !edu.institution.includes('Universal College'))
          .map((edu) => ({
            '@type': 'EducationalOrganization',
            'name': edu.institution,
            ...(edu.institutionUrl ? { 'url': edu.institutionUrl } : {})
          }))
      ],
      'hasCredential': siteData.certifications.map((cert) => ({
        '@type': 'EducationalOccupationalCredential',
        'name': cert.name,
        'credentialCategory': 'Professional Certification',
        'recognizedBy': {
          '@type': 'Organization',
          'name': cert.issuer,
          ...((cert as any).issuerUrl ? { 'url': (cert as any).issuerUrl } : {})
        },
        'url': cert.url,
        'validIn': {
          '@type': 'AdministrativeArea',
          'name': 'Worldwide'
        }
      })),
      'award': [
        "Dean's List 2026–2027 (Universal College Lanka / University of Central Lancashire)",
        "10% Academic Excellence Scholarship",
        "UCL International Foundation Year Merit Scholarship",
        "NASA International Space Apps Challenge 2026 Participant",
        "DevDash'26 Inaugural Hackathon Certificate of Participation"
      ],
      'memberOf': [
        {
          '@type': 'Organization',
          'name': 'The Radio Society of Sri Lanka',
          'url': 'https://rssl.lk'
        },
        {
          '@type': 'Organization',
          'name': 'Smithsonian Institution',
          'url': 'https://transcription.si.edu'
        }
      ],
      'knowsAbout': [
        'Software Engineering',
        'Systems Programming',
        'Reverse Engineering',
        'x86-64 Assembly Disassembly',
        'C',
        'C++',
        'Rust',
        'Go',
        'Python',
        'TypeScript',
        'JavaScript',
        'C#',
        '.NET Framework',
        'Obsidian Plugin Development',
        'CLI Architecture',
        'Linux System Administration & Internals',
        'Web Application Security',
        'Astro Framework',
        'React',
        'Tailwind CSS',
        'Oracle Cloud Infrastructure (OCI)',
        'NASA Space Apps Challenge',
        'Generative AI & LLMs',
        'Amateur Radio & RF Technologies',
        'Morse Code (CW)',
        'Visual Diagramming & JSON Canvas'
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#projects`,
      'name': 'Featured Software Engineering Projects',
      'description': 'Selected software systems and tools developed by Vishal Rashmika (Vishal Rashmika Perera)',
      'itemListElement': siteData.projects.map((proj, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': proj.name,
          'description': proj.description,
          'url': proj.demo || proj.github || baseUrl,
          ...(proj.github ? { 'codeRepository': proj.github } : {}),
          ...(proj.tags && proj.tags.length > 0 ? { 'keywords': proj.tags.join(', ') } : {})
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#blog`,
      'name': 'Technical Articles & Publications',
      'description': 'Engineering notes, reverse engineering tutorials, and systems writeups by Vishal Rashmika',
      'itemListElement': siteData.blogPosts.map((post, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': post.title,
          'url': post.href,
          'author': {
            '@id': `${baseUrl}/#person`
          },
          ...(post.excerpt ? { 'description': post.excerpt } : {})
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#achievements`,
      'name': 'Academic Honors & Excellence Scholarships',
      'description': 'Academic honors, dean\'s list rankings, and merit scholarships awarded to Vishal Rashmika (Universal College Lanka / University of Central Lancashire)',
      'itemListElement': (((siteData as any).achievements || []) as any[]).map((ach, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': ach.title,
          'description': ach.description,
          'publisher': {
            '@type': 'Organization',
            'name': ach.issuer,
            ...(ach.issuerUrl ? { 'url': ach.issuerUrl } : {})
          }
        }
      }))
    },
    {
      '@type': 'ItemList',
      '@id': `${baseUrl}/#volunteering`,
      'name': 'Volunteering & Community Contributions',
      'description': 'Community involvement, amateur radio research, and public archive preservation by Vishal Rashmika',
      'itemListElement': (((siteData as any).volunteering || []) as any[]).map((vol, idx) => ({
        '@type': 'ListItem',
        'position': idx + 1,
        'item': {
          '@type': 'CreativeWork',
          'name': `${vol.role} — ${vol.organization}`,
          'description': vol.description,
          ...(vol.url ? { 'url': vol.url } : {})
        }
      }))
    }
  ]
};
---

<!-- Basic Meta & Title -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Vishal Rashmika (Vishal Rashmika Perera)" />
<meta name="creator" content="Vishal Rashmika" />
<meta name="publisher" content="Vishal Rashmika" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Search Engine Verification -->
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<!-- Geographic & Local Signals (Full Sri Lanka & Western Province Geo-Targeting) -->
<meta name="geo.region" content="LK-1" />
<meta name="geo.placename" content="Colombo, Western Province, Sri Lanka" />
<meta name="geo.position" content="6.9271;79.8612" />
<meta name="ICBM" content="6.9271, 79.8612" />

<!-- Canonical & Language Alternates -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<!-- XML Sitemaps & Web App Manifest -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Favicon and App Icons -->
<link rel="icon" type="image/png" sizes="32x32" href="/icon.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icon.png" />

<!-- LLM / AI Discovery Endpoints (llmstxt.org Standard) -->
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Context Summary" />
<link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Comprehensive LLM Technical Context" />
<link rel="alternate" type="text/markdown" href="/.well-known/llms.txt" title="Well-Known LLM Context" />
<meta name="ai-content-declaration" content={`${baseUrl}/llms.txt`} />
<meta name="llms" content={`${baseUrl}/llms.txt`} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="profile" />
<meta property="og:site_name" content="Vishal Rashmika" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="Vishal Rashmika (Vishal Rashmika Perera) — Software Engineer & Systems Developer" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta property="profile:first_name" content="Vishal" />
<meta property="profile:last_name" content="Perera" />
<meta property="profile:username" content="VishalRashmika" />
<meta property="og:locality" content="Colombo" />
<meta property="og:region" content="Western Province" />
<meta property="og:country-name" content="Sri Lanka" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@Vishal_Rashmika" />
<meta name="twitter:creator" content="@Vishal_Rashmika" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content="Vishal Rashmika (Vishal Rashmika Perera) — Software Engineer & Systems Developer" />

<!-- Mobile & Device Styling -->
<meta name="theme-color" content="#0a0a0c" />
<meta name="color-scheme" content="dark light" />
<meta name="application-name" content="Vishal Rashmika" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Vishal Rashmika" />
<meta name="format-detection" content="telephone=no" />

<!-- Structured Data (Schema.org JSON-LD Graph) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
